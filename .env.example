# ==============================================================================
# Business Operator / OperatorOS — Environment Configuration (.env.example)
 | Bangalore (Track 2: AI Business Operator)
# ==============================================================================

# Application Environment
APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 1. Database (Supabase PostgreSQL + Automatic Local SQLite Fallback)
# ------------------------------------------------------------------------------
# PostgreSQL transactional database URL (e.g. Supabase, RDS, Neon, or local Docker)
# If left empty, OperatorOS automatically defaults to a persistent local SQLite DB (data/business_operator.db).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. TrueForge Agent Harness (npx @truefoundry/trueforge -> http://localhost:8790)
# ------------------------------------------------------------------------------
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=
TRUEFORGE_AGENT_ID=operator-os-chief-of-staff
TRUEFORGE_MODEL_PROFILE=truefoundry/gemini-2-5-flash

# ------------------------------------------------------------------------------
# 3. Open-Source AI Model Engine: Google Gemma 4 (Hackathon PS 03)
# ------------------------------------------------------------------------------
# Point to your local Ollama or your friend's 16GB laptop running 'ollama run gemma4:e4b'
# e.g. http://localhost:11434/v1 or http://192.168.1.15:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma4:e4b
GEMMA_TIMEOUT=15.0

# LLM Fallback Provider (Optional cloud failover: google, truefoundry, groq, openai)
LLM_PROVIDER=gemma_local
LLM_MODEL=gemma4:e4b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 4. TrueForge Sandbox (Isolated Python Code Execution via Daytona Cloud)
# ------------------------------------------------------------------------------
# Daytona Sandbox API key (with Sandboxes access & Snapshots write permission)
# If empty, the built-in isolated Python subprocess runner executes calculations locally.
DAYTONA_API_KEY=your_daytona_api_key_here
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# ------------------------------------------------------------------------------
# 5. n8n Integration Layer (Multi-Branch Webhook Router)
# ------------------------------------------------------------------------------
# URL of your n8n Cloud workspace for Purchase Orders, Payment Reminders & Campaigns
N8N_BASE_URL=https://your-workspace.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. Cognee (Semantic Business Memory & Store Policy Graph)
# ------------------------------------------------------------------------------
COGNEE_BASE_URL=https://tenant-id.aws.cognee.ai
COGNEE_PROJECT_ID=your_cognee_project_id
COGNEE_TENANT_ID=your_cognee_tenant_id
COGNEE_USER_ID=your_cognee_user_id
COGNEE_API_KEY=your_cognee_api_key_here

# ------------------------------------------------------------------------------
# 7. Sarvam AI (Multilingual Indian Speech-to-Text, Translation & Text-to-Speech)
# ------------------------------------------------------------------------------
# Supports automatic English (en-IN), Hindi (hi-IN), and Kannada (kn-IN) voice turns
# Includes automatic zero-downtime failover to Gemini Audio STT & Edge Neural TTS
SARVAM_API_KEY=your_sarvam_subscription_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# ------------------------------------------------------------------------------
# 8. CALL-E (Outbound AI Supplier Phone Call Agent — https://dashboard.heycall-e.com)
# ------------------------------------------------------------------------------
CALLE_API_KEY=your_calle_live_api_key_here
CALLE_BASE_URL=https://api.heycall-e.com
SUPPLIER_PHONE_NUMBER=+919876543210

# ------------------------------------------------------------------------------
# 9. Telegram Bot & Google Sheets Ledger (Payment Reminders, Campaigns & PO Logs)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
GOOGLE_SHEET_ID=your_google_spreadsheet_id
SPREADSHEET_WEBHOOK_URL=https://docs.google.com/spreadsheets/d/your_google_spreadsheet_id/edit
